{
  "name": "cuber",
  "description": "Rubik's Cube toolbox using Javascript for 100% client side single page application using Vue and Vuetify.",
  "version": "1.0.10",
  "author": "huazhechen",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "watch": "set NODE_OPTIONS=--openssl-legacy-provider && webpack server --mode=development --hot --progress --host=0.0.0.0",
    "build": "set NODE_OPTIONS=--openssl-legacy-provider && webpack --color --mode=production --progress",
    "verify": "node src/verify/cli.js",
    "verify:blecross": "playwright-cli run-code --filename scripts/verify-blecross-recompute.js",
    "verify:bleconnect": "playwright-cli run-code --filename scripts/verify-bleconnect.js",
    "verify:global-ble": "playwright-cli run-code --filename scripts/verify-global-ble.js",
    "verify:crossf2l": "playwright-cli -s=crossf2l open && playwright-cli -s=crossf2l run-code --filename scripts/verify-crossf2l-analysis.js",
    "test:ble": "tsc -p tsconfig.ble.json && node scripts/test-ble.js",
    "test:android": "node scripts/test-android-app.js",
    "test:desktop": "node desktop/desktop.test.cjs",
    "test:linux-scanner": "sh scripts/build-linux-scanner.sh && node scripts/test-linux-scanner.cjs",
    "desktop:dev": "electron .",
    "desktop:build": "npm run test:linux-scanner && npm run build && node scripts/gen-table.mjs dist && electron-builder --linux AppImage && node scripts/require-windows-scanner.cjs && electron-builder --win nsis",
    "desktop:linux": "npm run test:linux-scanner && npm run build && node scripts/gen-table.mjs dist && electron-builder --linux AppImage",
    "desktop:win": "node scripts/require-windows-scanner.cjs && npm run build && node scripts/gen-table.mjs dist && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.cuber.trainer.desktop",
    "productName": "魔方栈",
    "artifactName": "Cuber-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop/*.cjs",
      "desktop/*.html",
      "desktop/*.js",
      "resource/icon.png",
      "resource/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "www",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "resource/icon.png",
      "extraResources": [
        {
          "from": "desktop/linux-ble-scanner/publish",
          "to": "linux-ble-scanner",
          "filter": ["CuberBleScanner"]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resource/icon.png",
      "extraResources": [
        {
          "from": "desktop/windows-ble-scanner/publish",
          "to": "windows-ble-scanner",
          "filter": ["CuberBleScanner.exe"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/three": "0.130.0",
    "@types/webpack-env": "1.16.2",
    "@typescript-eslint/eslint-plugin": "4.28.3",
    "@typescript-eslint/parser": "4.28.3",
    "@webpack-cli/serve": "^3.0.1",
    "ajv": "^8.20.0",
    "clean-webpack-plugin": "^3.0.0",
    "clipboard": "2.0.8",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "6.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "eslint": "7.31.0",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "5.3.2",
    "material-design-icons": "3.0.1",
    "style-loader": "3.1.0",
    "text-loader": "0.0.1",
    "three": "0.130.1",
    "ts-loader": "9.2.3",
    "typescript": "4.3.5",
    "vue": "2.6.14",
    "vue-class-component": "7.2.6",
    "vue-property-decorator": "9.1.2",
    "vue-style-loader": "4.1.3",
    "vue-template-compiler": "2.6.14",
    "vuetify": "2.5.6",
    "webpack": "5.45.1",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "3.11.2"
  },
  "prettier": {
    "printWidth": 120
  },
  "dependencies": {
    "@types/aes-js": "^3.1.4",
    "aes-js": "^3.1.2"
  }
}
